{
  "name": "benson-genkit-backend",
  "version": "1.0.0",
  "description": "Genkit Backend for Benson Home Solutions",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "genkit:run": "npx genkit flow:run"
  },
  "dependencies": {
    "@genkit-ai/core": "^1.31.0",
    "@genkit-ai/firebase": "^1.31.0",
    "@genkit-ai/google-genai": "^1.31.0",
    "@genkit-ai/vertexai": "^1.31.0",
    "@pinecone-database/pinecone": "7.1.0",
    "dotenv": "17.3.1",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.2",
    "genkit": "^1.31.0",
    "googleapis": "171.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.5.0",
    "firebase-tools": "^15.12.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": "22"
  },
  "private": true
}
