# =============================================================================
# Benson Home Solutions — Environment Variables
# Copy to .env.local and fill in values. NEVER commit .env.local.
# =============================================================================

# -- Sanity CMS --
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# -- Database (Neon — Postgres serverless) --
DATABASE_URL=          # Neon connection string (pooled)
DATABASE_URL_UNPOOLED= # Neon direct connection (migrations)

# -- Vector / RAG --
PINECONE_API_KEY=
PINECONE_INDEX=benson-knowledge
PINECONE_ENVIRONMENT=
NOTION_API_KEY=        # For knowledge base ingestion
NOTION_DB_KNOWLEDGE=   # ID of the Notion Knowledge/SOP database

# -- AI / LLM --
ANTHROPIC_API_KEY=     # Claude 3.5 Sonnet — primary chatbot LLM
OPENAI_API_KEY=        # GPT-4o fallback + backup embeddings model

# -- 1build Cost Estimation API (GraphQL) --
ONEBUILD_API_KEY=      # External key: 1build_ext.YeCQuQQ4...
ONEBUILD_EMBEDDED_KEY= # Embedded key: 1build_emb.kEpuC0UB...
ONEBUILD_ENDPOINT=https://gateway-external.1build.com/

# -- Booking --
CAL_COM_API_KEY=
NEXT_PUBLIC_CAL_COM_LINK=

# -- Email --
RESEND_API_KEY=        # Transactional email
CONVERTKIT_API_KEY=    # Marketing sequences
CONVERTKIT_API_SECRET=

# -- Analytics --
GA4_MEASUREMENT_ID=
GA4_API_SECRET=        # Server-side Measurement Protocol
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# -- Call Tracking --
NEXT_PUBLIC_CALLRAIL_ACCOUNT_ID=
NEXT_PUBLIC_CALLRAIL_SWAP_TARGET=(541) 321-5115

# -- Emergency SMS (Twilio) --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=   # Twilio sending number

# -- Authentication (Phase 2) --
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# -- Geocoding / Property Data Pipeline --
GEOAPIFY_API_KEY=
USPS_USER_ID=          # Register at usps.com/business/web-tools-apis
HUD_API_TOKEN=         # Bearer token from huduser.gov
ONEBUILD_ENDPOINT=https://gateway-external.1build.com/
