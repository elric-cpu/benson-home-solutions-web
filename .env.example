# =============================================================================
# Benson Home Solutions — Environment Variables
# Copy to .env.local and fill in values. NEVER commit .env.local.
# =============================================================================

# -- Sanity CMS --
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# -- Database (Neon — Postgres serverless) --
DATABASE_URL=          # Neon connection string (pooled)
DATABASE_URL_UNPOOLED= # Neon direct connection (migrations)

# -- Vector / RAG --
PINECONE_API_KEY=
PINECONE_INDEX=benson-knowledge
NOTION_API_KEY=        # For knowledge base ingestion
NOTION_DB_KNOWLEDGE=   # ID of the Notion Knowledge/SOP database
NOTION_DB_PROPERTIES=  # ID of the Notion Properties database
NOTION_DB_CLIENTS=     # ID of the Notion Clients database
NOTION_DB_AGREEMENTS=  # ID of the Notion Agreements database
NOTION_DB_SERVICE_LOG= # ID of the Notion Service Log database

# -- AI / Genkit --
GOOGLE_GENAI_API_KEY=  # Google GenAI (Gemini) — primary AI model for all features
OPENROUTER_API_KEY=    # OpenRouter for Llama models
GUMLOOP_API_KEY=       # Gumloop API key
GUMLOOP_USER_ID=       # Gumloop User ID
GUMLOOP_PIPELINE_ID=   # Gumloop Pipeline ID (Default: 5KxuaKYH1edeEw14NXbbsv)
GUMLOOP_SEO_PIPELINE_ID= # Gumloop SEO Pipeline ID (Default: q919eEgk5ftsYnqebRngdt)

# -- CRM (HubSpot) --
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_CALCULATOR_FORM_ID=
NEXT_PUBLIC_HUBSPOT_CONTACT_FORM_ID=
HUBSPOT_ACCESS_TOKEN=

# -- Signatures --
SIGNATURE_PROVIDER=    # pandadoc, docusign, etc.
SIGNATURE_API_KEY=

# -- Email --
RESEND_API_KEY=        # Transactional email

# -- Analytics --
GA4_MEASUREMENT_ID=
GA4_API_SECRET=        # Server-side Measurement Protocol
METABASE_SITE_URL=
METABASE_EMBED_SECRET=
METABASE_SECRET_KEY=

# -- Sentry --
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# -- Geocoding / Property Data Pipeline --
NEXT_PUBLIC_GEOAPIFY_API_KEY=
GEOAPIFY_API_KEY=
HUD_API_TOKEN=         # Bearer token from huduser.gov

# -- Spatial Data (iGUIDE) --
IGUIDE_API_BASE_URL=
IGUIDE_API_KEY=        # For future authenticated operations

# -- Authority Briefs (Mux) --
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY=
MUX_GATED_CONTENT=false  # Set to true for signed playback only

# -- Forensic Documentation (CompanyCam) --
COMPANYCAM_ACCESS_TOKEN=
COMPANYCAM_WEBHOOK_TOKEN=

# -- Security / Secrets --
BHS_WEBHOOK_SECRET=    # For internal property enrichment webhooks
NOTION_WEBHOOK_SECRET= # For Notion automation sync
SUPABASE_WEBHOOK_SECRET= # For Supabase change tracking
ADMIN_SECRET=          # For admin dashboard access

REACT_EDITOR=atom

REACT_EDITOR=atom