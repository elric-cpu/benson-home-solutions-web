# =============================================================================
# Benson Home Solutions — Environment Variables
# Copy to .env.local and fill in values. NEVER commit .env.local.
# =============================================================================

# -- Sanity CMS --
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# -- Database (Neon — Postgres serverless) --
DATABASE_URL=          # Neon connection string (pooled)
DATABASE_URL_UNPOOLED= # Neon direct connection (migrations)

# -- Vector / RAG --
PINECONE_API_KEY=
PINECONE_INDEX=benson-knowledge
NOTION_API_KEY=        # For knowledge base ingestion
NOTION_DB_KNOWLEDGE=   # ID of the Notion Knowledge/SOP database
NOTION_DB_PROPERTIES=  # ID of the Notion Properties database
NOTION_DB_CLIENTS=     # ID of the Notion Clients database
NOTION_DB_AGREEMENTS=  # ID of the Notion Agreements database
NOTION_DB_SERVICE_LOG= # ID of the Notion Service Log database

# -- AI / Genkit (Benson Intelligence Layer) --
GOOGLE_GENAI_API_KEY=  # Optional only when using direct Google GenAI API keys; prefer Vertex/service-account auth
BENSON_GENKIT_BACKEND_URL= # Optional deployed callable base URL, e.g. https://us-central1-<project>.cloudfunctions.net
GCLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# -- Gcloud Services --
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET_NAME=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_CONTENT_ROOT=website_content
GOOGLE_WORKSPACE_SENDER=office@bensonhomesolutions.com
GOOGLE_WORKSPACE_IMPERSONATED_USER=
GOOGLE_WORKSPACE_AGREEMENTS_FOLDER_ID=

# -- Google Search Console (GSC) Monitoring --
GSC_CLIENT_EMAIL=      # Service account email with search console read access
GSC_PRIVATE_KEY=       # Service account private key (ensure \n are escaped)

# -- Geocoding / Property Data Pipeline (Gcloud Native) --
GOOGLE_MAPS_API_KEY=
HUD_API_TOKEN=         # Bearer token from huduser.gov

# -- CRM (HubSpot) --
HUBSPOT_ACCESS_TOKEN=

# -- Digital Signatures (PandaDoc) --
PANDADOC_API_KEY=
PANDADOC_TEMPLATE_ID=
SIGNATURE_PROVIDER=pandadoc

# -- Performance / Monitoring --
SENTRY_DSN=
NEXT_PUBLIC_APP_URL=https://bensonhomesolutions.com

# -- Metabase BI (Optional) --
METABASE_SITE_URL=
METABASE_SECRET_KEY=
