# =============================================================================
# Ralph for Claude Code — Project Configuration
# Benson Home Solutions Website Overhaul
# =============================================================================
# Docs: https://github.com/frankbria/ralph-claude-code
# =============================================================================

# --- Project Identity ---
PROJECT_NAME="benson-home-solutions-web"
PROJECT_TYPE="typescript"

# --- Claude Code Settings ---
CLAUDE_CODE_CMD="claude"
MAX_CALLS_PER_HOUR=100
CLAUDE_TIMEOUT_MINUTES=15
SESSION_CONTINUITY=true

# --- Rate Limiting & Circuit Breaker ---
# Ralph handles Claude's 5-hour API limit automatically.
# These defaults are sane for a Next.js build loop.
MAX_CONSECUTIVE_FAILURES=5
CIRCUIT_BREAKER_COOLDOWN=300

# --- Execution ---
VERBOSE=false
LIVE_STREAM=true

# --- Allowed Tools ---
# Restrict Claude Code to only the tools needed for this project.
ALLOWED_TOOLS="Bash(npm run build),Bash(npm run lint),Bash(npm run test),Bash(npm run format),Bash(npm run format:check),Bash(npm run db:generate),Bash(npm run db:push),Bash(npx next build),Bash(npx drizzle-kit *),Bash(npx playwright test *),Bash(npx lhci autorun),Bash(git *),Bash(ls *),Bash(cat *),Bash(find *),Bash(grep *),Bash(head *),Bash(tail *),Bash(wc *),Bash(mkdir *),Bash(cp *),Bash(mv *),Bash(rm *),Bash(echo *),Bash(curl *),Bash(jq *),Read,Write,Edit,MultiEdit"

# --- Exit Thresholds ---
# Stop the loop when the build is clean.
EXIT_ON_ZERO_ISSUES=true

# --- Custom Prompt Paths ---
# Ralph will auto-discover these from .ralph/ directory:
#   .ralph/PROMPT.md    — Master project context (injected every session)
#   .ralph/fix_plan.md  — Prioritized task list (updated each iteration)
#   .ralph/AGENT.md     — Optional agent persona (not used yet)
#   .ralph/specs/       — Optional spec files for deeper context
